// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Book {
  id          Int       @id @default(autoincrement())
  name        String
  description String    
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  comments Comment[] // Relation field: A book can have many comments
}

model Comment {
  id           Int      @id @default(autoincrement())
  author       String
  commentText  String   @map("comment_text") // Maps to comment_text column (needed as the names are not identic)
  createdAt    DateTime @default(now())
  bookId       Int      // Foreign key field

  book   Book  @relation(fields: [bookId], references: [id], onDelete: Cascade) // Relation field: A comment belongs to a book
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  createdAt    DateTime  @default(now())

  sessions Session[] // Relation field: A user can have multiple active sessions
}

model Session {
  id        String   @id
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}